# Copy to .env (gitignored) and fill in. Read by docker compose and, for local runs, by the services.
DB_NAME=rf
DB_USER=rf
DB_PASSWORD=change-me
RABBITMQ_USER=rf
RABBITMQ_PASSWORD=change-me

# docker-compose.yml only
IMAGE_TAG=local          # image version to run; the deploy pipeline sets this to the commit SHA
HTTP_PORT=80             # host port nginx listens on
# REGISTRY=ghcr.io/ofirvard/triariihomeproject
