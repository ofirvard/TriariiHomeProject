# Copy to .env (gitignored) and fill in. Read by docker compose and, for local runs, by the services.
# Keep comments on their own lines: the services read this file as Java properties.
DB_NAME=rf
DB_USER=rf
DB_PASSWORD=change-me
RABBITMQ_USER=rf
RABBITMQ_PASSWORD=change-me

# docker-compose.yml only.
# Image version to run; the deploy pipeline sets it to the commit SHA.
IMAGE_TAG=local
# Host port nginx listens on.
HTTP_PORT=80
# REGISTRY=ghcr.io/ofirvard/triariihomeproject
